      "role": "Reports the claim and provides evidence.",
      "type": "customer"
    },
    {
      "actor_id": "claims_agent",
      "name": "Claims Agent",
      "role": "Reviews the case and requests evidence.",
      "type": "employee"
    },
    {
      "actor_id": "risk_team",
      "name": "Risk Team",
      "role": "Reviews claims with fraud or legal risk.",
      "type": "team"
    }
  ],
  "systems": [
    {
      "system_id": "claims",
      "name": "Claims Management",
      "type": "internal",
      "owner": "Claims Operations"
    },
    {
      "system_id": "transactions",
      "name": "Transaction Ledger",
      "type": "internal",
      "owner": "Core Banking"
    }
  ],
  "documents": [
    {
      "document_id": "claim_evidence",
      "name": "Claim Evidence",
      "required": true,
      "source": "customer"
    },
    {
      "document_id": "transaction_reference",
      "name": "Transaction Reference",
      "required": true,
      "source": "transactions"
    }
  ],
  "rules": [
    {
      "rule_id": "claim_evidence_required",
      "description": "A claim requires evidence or a transaction reference before review.",
      "severity": "high",
      "source": "data/raw/process_qa_seed.md"
    },
    {
      "rule_id": "fraud_risk_requires_escalation",
      "description": "Claims involving fraud or legal risk require escalation.",
      "severity": "critical",
      "source": "data/raw/process_qa_seed.md"
    }
  ],
  "decisions": [
    {
      "decision_id": "claim_resolution_decision",
      "question": "Can the claim be resolved with the provided evidence?",
      "outcomes": [
        "approve_claim",
        "request_more_evidence",
        "reject_claim",
        "escalate"
      ]
    }
  ],
  "exceptions": [
    {
      "exception_id": "missing_claim_evidence",
      "condition": "Evidence or transaction reference is missing.",
      "resolution": "Ask the customer for additional evidence.",
      "escalation": "claims_agent"
    },
    {
      "exception_id": "fraud_risk_detected",
      "condition": "The claim indicates possible fraud or legal exposure.",
      "resolution": "Escalate the case to risk review.",
      "escalation": "risk_team"
    }
  ],
  "steps": [
    {
      "step_id": "create_claim_case",
      "sequence": 1,
      "name": "Create Claim Case",
      "type": "user_task",
      "actor_id": "customer",
      "system_id": "claims",
      "description": "Capture claim reason, transaction reference, and initial evidence.",
      "required_documents": [
        "claim_evidence",
        "transaction_reference"
      ],
      "rules": [
        "claim_evidence_required"
      ],
      "exceptions": [
        "missing_claim_evidence"
      ],
      "related_user_task_id": "file_claim",
      "executable": true,
      "actions": [
        "claim.create",
        "claim.intake",
        "claim.evidence.collect"
      ]
    },
    {
      "step_id": "review_claim",
      "sequence": 2,
      "name": "Review Claim",
      "type": "user_task",
      "actor_id": "claims_agent",
      "system_id": "transactions",
      "description": "Review billing and transaction data against the customer's evidence.",
      "decisions": [
        "claim_resolution_decision"
      ],
      "related_user_task_id": "manage_claim",
      "executable": true,
      "actions": [
        "billing.read",
        "transaction.reconcile"
      ]
    },
    {
      "step_id": "escalate_claim_if_needed",
      "sequence": 3,
      "name": "Escalate Claim If Needed",
      "type": "approval",
      "actor_id": "risk_team",
      "system_id": "claims",
      "description": "Escalate claims with fraud or legal risk.",
      "rules": [
        "fraud_risk_requires_escalation"
      ],
      "exceptions": [
        "fraud_risk_detected"
      ],
      "executable": false
    },
    {
      "step_id": "close_claim",
      "sequence": 4,
      "name": "Close Claim",
      "type": "end",
      "actor_id": "claims_agent",
      "system_id": "claims",
      "description": "Record the final resolution and notify the customer.",
      "executable": true,
      "actions": [
        "notification.send"
      ]
    }
  ],
  "metadata": {
    "generated_from_flow": "data/flows/claim_filing_process.flow.json",
