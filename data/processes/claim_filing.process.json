{
  "process_id": "claim.filing",
  "process_name": "Claim Filing",
  "version": "1.0.0",
  "status": "draft",
  "domain": "banking.claims",
  "owner": "Claims Operations",
  "description": "Structured process for creating, evidencing, reviewing, and resolving a customer claim.",
  "related_flow_ids": [
    "claim_filing_process",
    "claim.file.submit"
  ],
  "triggers": [
    "quiero hacer un reclamo",
