{
  "user_task_id": "make_loan_payment",
  "task": "make_loan_payment",
  "type": "user_task",
  "name": "Make Loan Payment",
  "description": "Collect payment instructions and apply a payment to a loan.",
  "front_actions": [
    {
      "action": "ui.loan_payment.submit",
      "type": "front_action",
      "operation": "create",
      "resource": "payment",
      "label": "Pay loan",
      "triggers": "payment.create"
    }
  ],
  "back_actions": [
    {
      "action": "loan.read",
      "type": "back_action",
      "operation": "read",
      "resource": "loan",
      "description": "Read loan balance."
    },
    {
      "action": "account.balance.validate",
      "type": "back_action",
      "operation": "validate",
      "resource": "account",
      "description": "Validate funds for payment."
    },
    {
      "action": "payment.create",
      "type": "back_action",
      "operation": "create",
      "resource": "payment",
      "description": "Create loan payment."
    },
    {
      "action": "notification.send",
      "type": "back_action",
      "operation": "notify",
      "resource": "notification",
      "description": "Notify the customer."
    }
  ]
}
