{
  "user_task_id": "manage_claim",
  "task": "manage_claim",
  "type": "user_task",
  "name": "Manage Claim",
  "description": "Register and process a customer claim for fees, debits, or reconciliation.",
  "front_actions": [
    {
      "action": "ui.claim.submit",
      "type": "front_action",
      "operation": "create",
      "resource": "claim",
      "label": "Submit claim",
      "triggers": "claim.create"
    }
  ],
  "back_actions": [
    {
      "action": "billing.read",
      "type": "back_action",
      "operation": "read",
      "resource": "billing",
      "description": "Read billed fees or charges."
    },
    {
      "action": "transaction.reconcile",
      "type": "back_action",
      "operation": "validate",
      "resource": "transaction",
      "description": "Reconcile transaction."
    },
    {
      "action": "claim.create",
      "type": "back_action",
      "operation": "create",
      "resource": "claim",
      "description": "Create claim case."
    }
  ]
}
