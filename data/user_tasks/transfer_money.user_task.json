{
  "user_task_id": "transfer_money",
  "task": "transfer_money",
  "type": "user_task",
  "name": "Transfer Money",
  "description": "Transfer money between accounts after validating customer and balance.",
  "front_actions": [
    {
      "action": "ui.transfer.form_submit",
      "type": "front_action",
      "operation": "create",
      "resource": "transfer",
      "label": "Submit transfer",
      "triggers": "transfer.create"
    }
  ],
  "back_actions": [
    {
      "action": "customer.validate",
      "type": "back_action",
      "operation": "validate",
      "resource": "customer",
      "description": "Validate the customer."
    },
    {
      "action": "account.balance.validate",
      "type": "back_action",
      "operation": "validate",
      "resource": "account",
      "description": "Validate available balance."
    },
    {
      "action": "transfer.create",
      "type": "back_action",
      "operation": "create",
      "resource": "transfer",
      "description": "Create money transfer."
    },
    {
      "action": "notification.send",
      "type": "back_action",
      "operation": "notify",
      "resource": "notification",
      "description": "Notify the customer."
    }
  ]
}
