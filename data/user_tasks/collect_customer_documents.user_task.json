{
  "user_task_id": "collect_customer_documents",
  "task": "collect_customer_documents",
  "type": "user_task",
  "name": "Collect Customer Documents",
  "description": "Collect KYC and supporting documents such as ID, address proof, and tax ID.",
  "front_actions": [
    {
      "action": "ui.documents.upload",
      "type": "front_action",
      "operation": "create",
      "resource": "document",
      "label": "Upload documents",
      "triggers": "document.create"
    }
  ],
  "back_actions": [
    {
      "action": "document.create",
      "type": "back_action",
      "operation": "create",
      "resource": "document",
      "description": "Store customer documents."
    },
    {
      "action": "document.verify",
      "type": "back_action",
      "operation": "validate",
      "resource": "document",
      "description": "Verify required documents are complete."
    }
  ]
}
